# Database. SQLite by default; use Postgres in production / docker compose.
DATABASE_URL=sqlite:///./aegis.db
# DATABASE_URL=postgresql+psycopg://aegis:aegis@db:5432/aegis

# Enables /demo/load and /demo/reset (sample flood scenario). Set false for real use.
DEMO_MODE=true

# Pipeline backends: "builtin" runs fully offline with no model downloads.
EMBEDDER=builtin            # builtin | sbert
STT_BACKEND=none            # none | whisper
WHISPER_MODEL=small         # tiny | base | small | medium (medium is better for Hindi, ~1.5 GB)
TRANSLATOR=passthrough      # passthrough | indictrans2

# Duplicate detection thresholds
# 0.45 suits the built-in embedder; use about 0.75 with EMBEDDER=sbert
DEDUP_SIMILARITY=0.45
DEDUP_RADIUS_KM=2.0
DEDUP_WINDOW_HOURS=6

# Severity tier cut-offs
TIER_CRITICAL=80
TIER_HIGH=60
TIER_MEDIUM=30
